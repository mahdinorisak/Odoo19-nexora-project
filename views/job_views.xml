<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_job_view_list" model="ir.ui.view">
        <field name="name">nexora.job.list</field>
        <field name="model">nexora.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="department_id"/>
                <field name="employee_count"/>
            </list>
        </field>
    </record>

    <record id="nexora_job_view_form" model="ir.ui.view">
        <field name="name">nexora.job.form</field>
        <field name="model">nexora.job</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="employee_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employees">
                            <field name="employee_ids" readonly="True">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nexora_job_view_search" model="ir.ui.view">
        <field name="name">nexora.job.search</field>
        <field name="model">nexora.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department_id"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_job" model="ir.actions.act_window">
        <field name="name">Job Positions</field>
        <field name="res_model">nexora.job</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

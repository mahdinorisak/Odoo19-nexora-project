<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_department_view_list" model="ir.ui.view">
        <field name="name">nexora.department.list</field>
        <field name="model">nexora.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="manager_id"/>
                <field name="employee_count"/>
            </list>
        </field>
    </record>

    <record id="nexora_department_view_form" model="ir.ui.view">
        <field name="name">nexora.department.form</field>
        <field name="model">nexora.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="employee_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employees">
                            <field name="employee_ids" readonly="True">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="job_title"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nexora_department_view_search" model="ir.ui.view">
        <field name="name">nexora.department.search</field>
        <field name="model">nexora.department</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name"/>
                <field name="manager_id"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_nexora_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">nexora.department</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

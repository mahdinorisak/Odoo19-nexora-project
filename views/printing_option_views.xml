<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_printing_option_view_list" model="ir.ui.view">
        <field name="name">nexora.printing.option.list</field>
        <field name="model">nexora.printing.option</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="printing_type_id"/>
                <field name="extra_price"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="nexora_printing_option_view_form" model="ir.ui.view">
        <field name="name">nexora.printing.option.form</field>
        <field name="model">nexora.printing.option</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="printing_type_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="True"/>
                            <field name="extra_price"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nexora_printing_option_view_search" model="ir.ui.view">
        <field name="name">nexora.printing.option.search</field>
        <field name="model">nexora.printing.option</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="printing_type_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Printing Type"
                            context="{'group_by': 'printing_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_printing_option" model="ir.actions.act_window">
        <field name="name">Printing Options</field>
        <field name="res_model">nexora.printing.option</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sale order lines -->
    <record id="nexora_sale_order_line_view_list" model="ir.ui.view">
        <field name="name">nexora.sale.order.line.list</field>
        <field name="model">nexora.sale.order.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Quantity"/>
                <field name="unit_price"/>
                <field name="printing_option_id"/>
                <field name="discount"/>
                <field name="subtotal" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="nexora_sale_order_line_view_form" model="ir.ui.view">
        <field name="name">nexora.sale.order.line.form</field>
        <field name="model">nexora.sale.order.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="True"/>
                            <field name="unit_price"/>
                            <field name="printing_type_id"/>
                            <field name="printing_option_id"/>
                            <field name="extra_price"/>
                            <field name="discount"/>
                            <field name="subtotal"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nexora_sale_order_line_view_search" model="ir.ui.view">
        <field name="name">nexora.sale.order.line.search</field>
        <field name="model">nexora.sale.order.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="product_id"/>
                <group>
                    <filter name="group_product" string="Product"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_order" string="Order"
                            context="{'group_by': 'order_id'}"/>
                    <filter name="group_printing" string="Printing Type"
                            context="{'group_by': 'printing_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_sale_order_line" model="ir.actions.act_window">
        <field name="name">Order Lines</field>
        <field name="res_model">nexora.sale.order.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Purchase order lines -->
    <record id="nexora_purchase_order_line_view_list" model="ir.ui.view">
        <field name="name">nexora.purchase.order.line.list</field>
        <field name="model">nexora.purchase.order.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Quantity"/>
                <field name="unit_cost"/>
                <field name="subtotal" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="nexora_purchase_order_line_view_form" model="ir.ui.view">
        <field name="name">nexora.purchase.order.line.form</field>
        <field name="model">nexora.purchase.order.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="product_id"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="True"/>
                            <field name="quantity"/>
                            <field name="unit_cost"/>
                            <field name="subtotal"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nexora_purchase_order_line_view_search" model="ir.ui.view">
        <field name="name">nexora.purchase.order.line.search</field>
        <field name="model">nexora.purchase.order.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="product_id"/>
                <group>
                    <filter name="group_product" string="Product"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_order" string="Order"
                            context="{'group_by': 'order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_purchase_order_line" model="ir.actions.act_window">
        <field name="name">Purchase Lines</field>
        <field name="res_model">nexora.purchase.order.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

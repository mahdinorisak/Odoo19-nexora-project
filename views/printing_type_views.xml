<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_printing_type_view_list" model="ir.ui.view">
        <field name="name">nexora.printing.type.list</field>
        <field name="model">nexora.printing.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="base_price"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="nexora_printing_type_view_form" model="ir.ui.view">
        <field name="name">nexora.printing.type.form</field>
        <field name="model">nexora.printing.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="True"/>
                            <field name="base_price"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Options">
                            <field name="option_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="extra_price"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nexora_printing_type_view_search" model="ir.ui.view">
        <field name="name">nexora.printing.type.search</field>
        <field name="model">nexora.printing.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_nexora_printing_type" model="ir.actions.act_window">
        <field name="name">Printing Types</field>
        <field name="res_model">nexora.printing.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

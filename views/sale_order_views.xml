<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_sale_order_view_list" model="ir.ui.view">
        <field name="name">nexora.sale.order.list</field>
        <field name="model">nexora.sale.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="order_date"/>
                <field name="customer_id"/>
                <field name="user_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="nexora_sale_order_view_form" model="ir.ui.view">
        <field name="name">nexora.sale.order.form</field>
        <field name="model">nexora.sale.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark as Done" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" string="Back to Quotation" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" readonly="state != 'draft'"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="order_date" readonly="state != 'draft'"/>
                            <field name="tax_rate" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="printing_type_id"/>
                                    <field name="printing_option_id"
                                           domain="[('printing_type_id', '=', printing_type_id)]"
                                           invisible="not printing_type_id"/>
                                    <field name="discount"/>
                                    <field name="subtotal"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="nexora_sale_order_view_search" model="ir.ui.view">
        <field name="name">nexora.sale.order.search</field>
        <field name="model">nexora.sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="user_id"/>
                <filter name="my_orders" string="My Orders"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="state_draft" string="Quotations"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="state_confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="state_done" string="Done"
                        domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_customer" string="Customer"
                            context="{'group_by': 'customer_id'}"/>
                    <filter name="group_user" string="Salesperson"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Order Month"
                            context="{'group_by': 'order_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_quotation" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">nexora.sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['draft', 'cancel'])]</field>
    </record>

    <record id="action_nexora_sale_order" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">nexora.sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['confirmed', 'done'])]</field>
    </record>

</odoo>

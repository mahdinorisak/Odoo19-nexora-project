<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_material_view_list" model="ir.ui.view">
        <field name="name">nexora.material.list</field>
        <field name="model">nexora.material</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="cost"/>
            </list>
        </field>
    </record>

    <record id="nexora_material_view_form" model="ir.ui.view">
        <field name="name">nexora.material.form</field>
        <field name="model">nexora.material</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="cost"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nexora_material_view_search" model="ir.ui.view">
        <field name="name">nexora.material.search</field>
        <field name="model">nexora.material</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_nexora_material" model="ir.actions.act_window">
        <field name="name">Materials</field>
        <field name="res_model">nexora.material</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_product_category_view_list" model="ir.ui.view">
        <field name="name">nexora.product.category.list</field>
        <field name="model">nexora.product.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="nexora_product_category_view_form" model="ir.ui.view">
        <field name="name">nexora.product.category.form</field>
        <field name="model">nexora.product.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Sub Categories">
                            <field name="child_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nexora_product_category_view_search" model="ir.ui.view">
        <field name="name">nexora.product.category.search</field>
        <field name="model">nexora.product.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_parent" string="Parent Category"
                            context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_product_category" model="ir.actions.act_window">
        <field name="name">Product Categories</field>
        <field name="res_model">nexora.product.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
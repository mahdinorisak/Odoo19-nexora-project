<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_employee_view_list" model="ir.ui.view">
        <field name="name">nexora.employee.list</field>
        <field name="model">nexora.employee</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="job_title"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="nexora_employee_view_form" model="ir.ui.view">
        <field name="name">nexora.employee.form</field>
        <field name="model">nexora.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Employee name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="id"/>
                            <field name="job_title"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="hire_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="nexora_employee_view_search" model="ir.ui.view">
        <field name="name">nexora.employee.search</field>
        <field name="model">nexora.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="job_title"/>
                <field name="department_id"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_manager" string="Manager"
                            context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">nexora.employee</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

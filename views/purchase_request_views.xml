<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_purchase_request_view_list" model="ir.ui.view">
        <field name="name">nexora.purchase.request.list</field>
        <field name="model">nexora.purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancel', 'rejected')"
                  decoration-success="state == 'ordered'"
                  decoration-info="state == 'submitted'">
                <field name="name"/>
                <field name="request_date"/>
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="vendor_id"/>
                <field name="date_needed"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="nexora_purchase_request_view_form" model="ir.ui.view">
        <field name="name">nexora.purchase.request.form</field>
        <field name="model">nexora.purchase.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="nexora_app.group_nexora_production_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'submitted'"
                            groups="nexora_app.group_nexora_production_manager"/>
                    <button name="action_create_order" string="Create Purchase Order"
                            type="object" class="btn-primary"
                            invisible="state != 'approved'"
                            groups="nexora_app.group_nexora_production_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'submitted', 'approved')"/>
                    <button name="action_draft" string="Back to Draft" type="object"
                            invisible="state not in ('rejected', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,ordered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_order" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not purchase_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Purchase Order</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="vendor_id" readonly="state in ('ordered', 'cancel')"/>
                        </group>
                        <group>
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="date_needed" readonly="state != 'draft'"/>
                            <field name="approved_by"/>
                            <field name="purchase_order_id"/>
                            <field name="currency_id" invisible="True"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested Items">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="estimated_cost"/>
                                    <field name="subtotal"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Reason">
                            <field name="reason" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="nexora_purchase_request_view_search" model="ir.ui.view">
        <field name="name">nexora.purchase.request.search</field>
        <field name="model">nexora.purchase.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="vendor_id"/>
                <filter name="my_requests" string="My Requests"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="ordered" string="Ordered"
                        domain="[('state', '=', 'ordered')]"/>
                <group>
                    <filter name="group_user" string="Requested By"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Request Month"
                            context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_purchase_request" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">nexora.purchase.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_warehouse_view_list" model="ir.ui.view">
        <field name="name">nexora.warehouse.list</field>
        <field name="model">nexora.warehouse</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="city"/>
                <field name="location_count"/>
            </list>
        </field>
    </record>

    <record id="nexora_warehouse_view_form" model="ir.ui.view">
        <field name="name">nexora.warehouse.form</field>
        <field name="model">nexora.warehouse</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Locations">
                            <field name="location_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="parent_id"/>
                                    <field name="usage"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nexora_warehouse" model="ir.actions.act_window">
        <field name="name">Warehouses</field>
        <field name="res_model">nexora.warehouse</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

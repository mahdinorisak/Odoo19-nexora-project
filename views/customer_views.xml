<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_customer_view_list" model="ir.ui.view">
        <field name="name">nexora.customer.list</field>
        <field name="model">nexora.customer</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="customer_type_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="city"/>
            </list>
        </field>
    </record>

    <record id="nexora_customer_view_form" model="ir.ui.view">
        <field name="name">nexora.customer.form</field>
        <field name="model">nexora.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Customer name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="id"/>
                            <field name="customer_type_id"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="country_id"/>
                            <field name="full_address"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="nexora_customer_view_search" model="ir.ui.view">
        <field name="name">nexora.customer.search</field>
        <field name="model">nexora.customer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="email"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Customer Type"
                            context="{'group_by': 'customer_type_id'}"/>
                    <filter name="group_country" string="Country"
                            context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nexora_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">nexora.customer</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_product_view_list" model="ir.ui.view">
        <field name="name">nexora.product.list</field>
        <field name="model">nexora.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="product_type_id"/>
                <field name="material_id"/>
                <field name="cost_price"/>
                <field name="sale_price"/>
                <field name="margin"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="nexora_product_view_form" model="ir.ui.view">
        <field name="name">nexora.product.form</field>
        <field name="model">nexora.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Product name"/></h1>
                    </div>
                    <group>
                        <group>
                         <field name="code" readonly="id"/>
                            <field name="category_id"/>
                            <field name="product_type_id"/>
                            <field name="material_id"/>
                            <field name="printing_type_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="True"/>
                            <field name="cost_price"/>
                            <field name="sale_price"/>
                            <field name="margin"/>
                            <field name="min_quantity"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="nexora_product_view_search" model="ir.ui.view">
        <field name="name">nexora.product.search</field>
        <field name="model">nexora.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="material_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_type" string="Product Type"
                            context="{'group_by': 'product_type_id'}"/>
                    <filter name="group_material" string="Material"
                            context="{'group_by': 'material_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="nexora_product_view_kanban" model="ir.ui.view">
        <field name="name">nexora.product.kanban</field>
        <field name="model">nexora.product</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="image_128" widget="image" class="me-3"
                                   options="{'img_class': 'o_image_64_cover'}"/>
                            <div>
                                <field name="name" class="fw-bold fs-5"/>
                                <div class="text-muted"><field name="code"/></div>
                                <div><field name="category_id"/></div>
                                <div><field name="sale_price" widget="monetary"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_nexora_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">nexora.product</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_vendor_category_view_list" model="ir.ui.view">
        <field name="name">nexora.vendor.category.list</field>
        <field name="model">nexora.vendor.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="vendor_count"/>
            </list>
        </field>
    </record>

    <record id="nexora_vendor_category_view_form" model="ir.ui.view">
        <field name="name">nexora.vendor.category.form</field>
        <field name="model">nexora.vendor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="vendor_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vendors">
                            <field name="vendor_ids" readonly="True">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="rating"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nexora_vendor_category_view_search" model="ir.ui.view">
        <field name="name">nexora.vendor.category.search</field>
        <field name="model">nexora.vendor.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_nexora_vendor_category" model="ir.actions.act_window">
        <field name="name">Vendor Categories</field>
        <field name="res_model">nexora.vendor.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

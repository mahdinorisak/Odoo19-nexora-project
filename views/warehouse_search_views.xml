<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_warehouse_view_search" model="ir.ui.view">
        <field name="name">nexora.warehouse.search</field>
        <field name="model">nexora.warehouse</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

</odoo>

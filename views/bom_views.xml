<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_bom_view_list" model="ir.ui.view">
        <field name="name">nexora.bom.list</field>
        <field name="model">nexora.bom</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="component_cost"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="nexora_bom_view_form" model="ir.ui.view">
        <field name="name">nexora.bom.form</field>
        <field name="model">nexora.bom</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="currency_id" invisible="True"/>
                            <field name="component_cost"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Components">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="component_id"/>
                                    <field name="quantity"/>
                                    <field name="cost"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nexora_bom_view_search" model="ir.ui.view">
        <field name="name">nexora.bom.search</field>
        <field name="model">nexora.bom</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_nexora_bom" model="ir.actions.act_window">
        <field name="name">Bills of Materials</field>
        <field name="res_model">nexora.bom</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

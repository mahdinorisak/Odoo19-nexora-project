<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_purchase_request_own" model="ir.rule">
        <field name="name">Purchase requests: own requests only</field>
        <field name="model_id" ref="model_nexora_purchase_request"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_nexora_user'))]"/>
    </record>

    <record id="rule_purchase_request_all" model="ir.rule">
        <field name="name">Purchase requests: all (production managers)</field>
        <field name="model_id" ref="model_nexora_purchase_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_nexora_production_manager'))]"/>
    </record>

    <record id="rule_purchase_request_line_own" model="ir.rule">
        <field name="name">Purchase request lines: own requests only</field>
        <field name="model_id" ref="model_nexora_purchase_request_line"/>
        <field name="domain_force">[('request_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_nexora_user'))]"/>
    </record>

    <record id="rule_purchase_request_line_all" model="ir.rule">
        <field name="name">Purchase request lines: all (production managers)</field>
        <field name="model_id" ref="model_nexora_purchase_request_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_nexora_production_manager'))]"/>
    </record>

</odoo>

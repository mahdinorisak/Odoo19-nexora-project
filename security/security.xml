<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_nexora" model="ir.module.category">
        <field name="name">Nexora</field>
    </record>

    <record id="res_groups_privilege_nexora" model="res.groups.privilege">
        <field name="name">Nexora</field>
        <field name="category_id" ref="module_category_nexora"/>
    </record>

    <record id="group_nexora_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_nexora_sales_manager" model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora"/>
        <field name="implied_ids" eval="[(4, ref('group_nexora_user'))]"/>
    </record>

    <record id="group_nexora_production_manager" model="res.groups">
        <field name="name">Production Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora"/>
        <field name="implied_ids" eval="[(4, ref('group_nexora_user'))]"/>
    </record>

    <record id="group_nexora_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_nexora"/>
        <field name="implied_ids" eval="[(4, ref('group_nexora_sales_manager')), (4, ref('group_nexora_production_manager'))]"/>
    </record>

    <!-- Odoo's own administrators become Nexora administrators -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_nexora_admin'))]"/>
    </record>

    <!-- Record rules -->
    <record id="rule_sale_order_own" model="ir.rule">
        <field name="name">Sale orders: own orders only</field>
        <field name="model_id" ref="model_nexora_sale_order"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_nexora_user'))]"/>
    </record>

    <record id="rule_sale_order_all" model="ir.rule">
        <field name="name">Sale orders: all orders (managers)</field>
        <field name="model_id" ref="model_nexora_sale_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_nexora_sales_manager'))]"/>
    </record>

    <record id="rule_sale_order_line_own" model="ir.rule">
        <field name="name">Sale order lines: own orders only</field>
        <field name="model_id" ref="model_nexora_sale_order_line"/>
        <field name="domain_force">[('order_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_nexora_user'))]"/>
    </record>

    <record id="rule_sale_order_line_all" model="ir.rule">
        <field name="name">Sale order lines: all (managers)</field>
        <field name="model_id" ref="model_nexora_sale_order_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_nexora_sales_manager'))]"/>
    </record>

    <!-- Multi-company rules (global: no groups) -->
    <record id="rule_sale_order_company" model="ir.rule">
        <field name="name">Sale orders: multi-company</field>
        <field name="model_id" ref="model_nexora_sale_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_purchase_order_company" model="ir.rule">
        <field name="name">Purchase orders: multi-company</field>
        <field name="model_id" ref="model_nexora_purchase_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>

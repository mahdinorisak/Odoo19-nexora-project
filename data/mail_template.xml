<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_template_sale_confirmed" model="mail.template">
        <field name="name">Nexora: Sale Order Confirmed</field>
        <field name="model_id" ref="model_nexora_sale_order"/>
        <field name="subject">Your order {{ object.name }} is confirmed</field>
        <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.customer_id.email }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0;">
                <p>Hello <t t-out="object.customer_id.name or ''"/>,</p>
                <p>Your order <strong t-out="object.name"/> has been confirmed.</p>
                <ul>
                    <li t-foreach="object.line_ids" t-as="line">
                        <t t-out="line.description"/> x <t t-out="line.quantity"/>
                    </li>
                </ul>
                <p>Total: <t t-out="object.currency_id.symbol"/> <t t-out="'%.2f' % object.amount_total"/></p>
                <p>Thank you,<br/><t t-out="object.user_id.name or ''"/></p>
            </div>
        </field>
    </record>

</odoo>

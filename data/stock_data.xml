<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="warehouse_main" model="nexora.warehouse">
            <field name="name">Main Warehouse</field>
            <field name="code">WH</field>
        </record>

        <record id="location_stock" model="nexora.location">
            <field name="name">Stock</field>
            <field name="usage">internal</field>
            <field name="warehouse_id" ref="warehouse_main"/>
        </record>

        <record id="location_vendors" model="nexora.location">
            <field name="name">Vendors</field>
            <field name="usage">vendor</field>
        </record>

        <record id="location_customers" model="nexora.location">
            <field name="name">Customers</field>
            <field name="usage">customer</field>
        </record>

        <record id="location_production" model="nexora.location">
            <field name="name">Production</field>
            <field name="usage">production</field>
        </record>

        <record id="location_adjustment" model="nexora.location">
            <field name="name">Inventory Adjustment</field>
            <field name="usage">inventory</field>
        </record>

    </data>
</odoo>

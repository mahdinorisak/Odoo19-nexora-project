<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexora_stock_report_wizard_view_form" model="ir.ui.view">
        <field name="name">nexora.stock.report.wizard.form</field>
        <field name="model">nexora.stock.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Print PDF" type="object"
                            class="btn-primary"/>
                    <button name="action_view_moves" string="Show Moves" type="object"
                            class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nexora_stock_report_wizard" model="ir.actions.act_window">
        <field name="name">Stock Report</field>
        <field name="res_model">nexora.stock.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
